    "/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "List users in school",
        "description": "Returns all users in the teacher's school, ordered by name.\n\n- No `role` filter \u2192 returns teachers **and** students.\n- `?role=student` \u2192 students only.\n- `?role=teacher` \u2192 teachers only.\n\nTeacher access only.",
        "operationId": "list_users_users_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(teacher|student)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by role",
              "title": "Role"
            },
            "description": "Filter by role"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserRead"
                  },
                  "title": "Response List Users Users Get"
                }
              }
            }
          },
          "403": {
            "description": "Teacher access required."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
