                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered."
          },
          "403": {
            "description": "Teacher access required."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
